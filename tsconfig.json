{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    /* CLAUDE.md kod standardı: TypeScript strict */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    /*
     * `scripts/font-altkume.ts` Node'un yerel tip sıyırmasıyla çalışıyor
     * (`node --experimental-strip-types`) ve Node, TS dosyasını ancak
     * uzantısı yazılırsa çözüyor. `noEmit` açık olduğu için bu seçenek
     * güvenli: derleme çıktısı üretilmediğinden yanlış uzantılı bir import
     * çıktıya sızamaz. Bir bağımlılık (tsx) eklememek için tercih edildi.
     */
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./src/payload.config.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts",
    ".next/dev/types/**/*.ts"
  ],
  // ⚠️ `src/migrations/index.ts` ÜRETİLEN ve KULLANILMAYAN bir dosya:
  // Payload `migrate:create` sırasında yazıyor, göçleri bulmak için ise
  // dizini okuyor. Depoda tutulmuyor (bkz. .gitignore ve
  // src/lib/gocIndeksi.test.ts).
  //
  // Tip kontrolü dışında bırakılmasının somut gerekçesi: dal değiştirince
  // diskte kalan eski bir kopya, artık var olmayan bir göç dosyasını içe
  // aktarıyor ve `tsc` "Cannot find module" ile düşüyor. İzlenmeyen bir
  // ÜRETİLMİŞ dosyanın kapıyı kapatması, kapıyı anlamsızlaştırır.
  "exclude": ["node_modules", ".next", "dist", "build", "src/migrations/index.ts"]
}
