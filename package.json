{
  "name": "aslihangyd-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:up": "docker compose --env-file .env -f docker/compose.dev.yml up -d",
    "db:down": "docker compose --env-file .env -f docker/compose.dev.yml down",
    "db:logs": "docker compose --env-file .env -f docker/compose.dev.yml logs -f",
    "db:reset": "docker compose --env-file .env -f docker/compose.dev.yml down -v && docker compose --env-file .env -f docker/compose.dev.yml up -d",
    "payload": "payload",
    "prepare": "husky",
    "seed": "payload run scripts/seed.ts",
    "font:altkume": "node --experimental-strip-types scripts/font-altkume.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@payloadcms/db-postgres": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/translations": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "graphql": "16.14.2",
    "maplibre-gl": "^6.1.0",
    "next": "16.2.12",
    "payload": "3.87.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
