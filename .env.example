# ============================================================================
# aslihangyd.com — ortam değişkenleri örneği
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
#
# CLAUDE.md kural 7: Hiçbir API anahtarı, şifre veya token koda girmez.
# `.env` dosyası .gitignore'dadır, ASLA commit edilmez.
#
# "AslihanTarafindanDoldurulacak" yazan değerler gerçek değildir; ilgili
# hesaptan alınıp elle girilmelidir.
#
# ⚠️ NEDEN NEREDEYSE HİÇ "NEXT_PUBLIC_" YOK
#
# Next.js bu önekli değişkenleri DERLEME ANINDA paketin içine gömer. Üretim
# imajı GitHub Actions'ta, bu değişkenler tanımlı değilken derleniyor — yani
# önekli bir değişken yayında BOŞ kalır ve hata da vermez. 12 Ağustos 2026'da
# dokuz değişken birden bu yüzden ölüydü: harita açılmıyor, bot koruması
# kapalı, analitik yüklenmiyor, videolar "yapılandırılmadı" diyordu.
#
# Ön eksiz adlar ÇALIŞMA ZAMANINDA okunur: değeri burada değiştirip
# uygulamayı yeniden başlatmak yeter, imajı yeniden derlemek gerekmez.
# Değerler sunucuda okunur, istemciye prop olarak iner.
# Gerekçenin tamamı: src/lib/harita/sunucu.ts
# ============================================================================


# --- Veritabanı ------------------------------------------------------------
#
# Aşağıdaki POSTGRES_* değerleri iki yerde birden kullanılır:
#   1) docker/compose.dev.yml → container'ı bu bilgilerle oluşturur
#   2) DATABASE_URI           → uygulamanın bağlanacağı adres
# Bu yüzden ikisi TUTARLI olmalıdır. Şifreyi değiştirirseniz DATABASE_URI'yi
# de güncelleyin ve `pnpm db:reset` ile veritabanını yeniden oluşturun
# (mevcut container eski şifreyle kalır).

POSTGRES_USER=aslihangyd
POSTGRES_DB=aslihangyd_dev

# Geliştirme veritabanı şifresi.
# Nereden: kendiniz üretin →  openssl rand -hex 16
# Not: veritabanı yalnızca 127.0.0.1'e bağlıdır, dışarıya açık değildir.
POSTGRES_PASSWORD=AslihanTarafindanDoldurulacak

# PostgreSQL + PostGIS bağlantı adresi.
# Yukarıdaki POSTGRES_* değerleriyle eşleşmelidir.
# Biçim: postgres://KULLANICI:SIFRE@SUNUCU:PORT/VERITABANI
DATABASE_URI=postgres://aslihangyd:AslihanTarafindanDoldurulacak@localhost:5432/aslihangyd_dev

# Redis bağlantı adresi (önbellek ve oturum).
# Geliştirme: docker/compose.dev.yml ile birlikte gelir, yalnızca 127.0.0.1.
REDIS_URL=redis://localhost:6379


# --- Payload CMS -----------------------------------------------------------

# Payload'ın oturum çerezlerini ve token'ları imzalamakta kullandığı gizli anahtar.
# Nereden: kendiniz üretin →  openssl rand -base64 32
# Production'da geliştirme değerinden FARKLI olmalıdır.
PAYLOAD_SECRET=AslihanTarafindanDoldurulacak

# Sitenin genel adresi. Payload e-posta bağlantılarında ve SEO'da kullanılır.
# Geliştirme: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000


# --- Harita ----------------------------------------------------------------

# MapTiler harita API anahtarı (MapLibre GL JS ile kullanılır).
# Nereden: maptiler.com → giriş yapın → Account → API Keys → anahtarı kopyalayın
#
# ⚠️ Boşsa /harita sayfası boş durum gösterir; kırık gri bir kutu değil.
# OSM'den içe aktarılan ilgi noktalarının göründüğü tek yer orasıdır.
#
# ⚠️ Anahtar tarayıcıya gider (harita isteklerinin içinde) — gizlenemez.
# Korunma yolu MapTiler panelinden ALAN ADI KISITI koymaktır:
# Account → API Keys → anahtar → Allowed origins → aslihangyd.com
MAPTILER_ANAHTARI=AslihanTarafindanDoldurulacak


# --- Video / CDN -----------------------------------------------------------
# CLAUDE.md kod standardı: video ASLA self-host edilmez, CDN üzerinden HLS.

# Bunny Stream kütüphane kimliği.
# Nereden: bunny.net → Stream → kütüphaneyi seçin → Library ID
BUNNY_STREAM_LIBRARY_ID=AslihanTarafindanDoldurulacak

# Bunny Stream API anahtarı (video yükleme/yönetim için).
# Nereden: bunny.net → Stream → kütüphaneyi seçin → API → API Key
BUNNY_STREAM_API_KEY=AslihanTarafindanDoldurulacak

# Bunny Stream oynatma alan adı (adreslerde görünür, gizli değildir).
# Nereden: bunny.net → Stream → kütüphaneyi seçin → Pull Zone / CDN Hostname
#
# ⚠️ Bu ve BUNNY_STREAM_LIBRARY_ID boşsa video bölümü "oynatıcı
# yapılandırılmadı" der; kırık bir çerçeve göstermez.
#
# ⚠️ Kütüphane kimliğinin ayrı bir "istemci kopyası" ARTIK YOK.
# Eskiden NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID diye ikinci bir satır vardı;
# oynatıcı adresi tarayıcıda kurulduğu için gerekli sanılmıştı. Adres artık
# sunucuda kuruluyor ve oynatıcıya hazır iniyor, tek değişken yetiyor.
BUNNY_STREAM_CDN_HOSTNAME=AslihanTarafindanDoldurulacak


# --- E-posta ---------------------------------------------------------------
# İletişim formu ve Payload bildirimlerinin gönderimi için SMTP bilgileri.
# Nereden: e-posta sağlayıcınızın panelinden (ör. Resend, Brevo, Yandex 360)

SMTP_HOST=AslihanTarafindanDoldurulacak
SMTP_PORT=587
SMTP_USER=AslihanTarafindanDoldurulacak
SMTP_PASSWORD=AslihanTarafindanDoldurulacak

# Giden e-postalarda görünecek gönderen adresi ve adı.
SMTP_FROM_ADDRESS=AslihanTarafindanDoldurulacak
SMTP_FROM_NAME=Aslıhan GYD


# --- İletişim --------------------------------------------------------------

# WhatsApp iletişim numarası (uluslararası biçim, + ve boşluk olmadan).
# Örnek biçim: 905XXXXXXXXX  — gerçek numara Aslıhan tarafından verilecek.
#
# ⚠️ Adın sonunda "SI" YOK. Burası bir süre `..._NUMARASI` yazıyordu ama
# kod `..._NUMARA` okuyor; belgeyi harfiyen izleyen biri WhatsApp düğmesini
# boş numarayla yayına alır ve hiçbir hata görmezdi.
# src/lib/ortam.test.ts bu sapmayı artık derlemede yakalıyor.
#
# ⚠️ Bu üçü YEDEKTİR. Asıl kaynak CMS → Kurumsal Bilgiler; panelden girilen
# değer buradakini ezer. Burası yalnızca CMS henüz doldurulmadıysa devreye
# girer.
WHATSAPP_NUMARA=AslihanTarafindanDoldurulacak

# İletişim sayfasında ve altbilgide görünen telefon ve e-posta.
ILETISIM_TELEFON=AslihanTarafindanDoldurulacak
ILETISIM_EPOSTA=AslihanTarafindanDoldurulacak


# --- Analitik --------------------------------------------------------------
# CLAUDE.md kural 8: Çerez onayı alınmadan analitik scripti YÜKLENMEZ.
# Bu değişkenin dolu olması scriptin yükleneceği anlamına gelmez; yükleme
# kullanıcı onayına bağlıdır.

# Nereden: Umami panelinden (kendi barındırılan ya da umami.is).
# Geliştirmede genellikle BOŞ bırakılır: geliştirme trafiğini ölçüme
# karıştırmak veriyi bozar.
UMAMI_URL=
UMAMI_SITE_ID=

# --- Yerel ağdan erişim (yalnızca geliştirme) -------------------------------

# ⚠️ Telefondan veya tabletten `pnpm dev`e bağlanacaksanız GEREKLİ.
#
# Next 16 çapraz kaynak geliştirme isteklerini varsayılan olarak engelliyor:
# sunucu 200 döner ama sayfa BEYAZ kalır ve hata da görünmez — teşhisi en
# zor arıza türü. Kendi makinenizin yerel ağ adresini yazın, virgülle
# birden fazla:
#
#   DEV_IZINLI_KAYNAKLAR=192.168.1.113,192.168.1.50
#
# Adres KODA GÖMÜLMEZ: her geliştiricinin yerel ağ adresi farklı.
# Yalnızca geliştirmede etkilidir; üretim derlemesinde okunmaz.
DEV_IZINLI_KAYNAKLAR=


# --- Bakım görevleri -------------------------------------------------------

# `/api/bakim` ucunun kimlik anahtarı. Cron görevleri bunu gönderir.
#
# ⚠️ ÜRETİMDE ZORUNLU: boşsa EİDS yetki süresi kontrolü çalışmaz ve
# yetkisi dolan ilan yayında kalır — idari yaptırım riski. Geliştirmede
# yalnızca ucu elle denemek için gerekir.
# Üret:  openssl rand -hex 32
BAKIM_ANAHTARI=


# --- Bot koruması (Turnstile) ----------------------------------------------
# Cloudflare Turnstile. Nereden: dash.cloudflare.com -> Turnstile -> Add site
#
# İkisi de boşsa doğrulama katmanı devre dışı kalır; form çalışmaya devam
# eder, yalnızca bal küpü ve hız sınırı korur. Geliştirmede boş bırakmak
# normaldir.

# Site anahtarı: widget'ta görünür, gizli değildir.
# Ön eki yok — değer sunucuda okunup forma prop olarak iniyor.
TURNSTILE_SITE_ANAHTARI=

# ⚠️ SUNUCU TARAFI — asla istemciye gönderilmez.
TURNSTILE_GIZLI_ANAHTAR=


# --- AI doğal dil arama (Anthropic) ----------------------------------------
# /portfoy sayfasındaki "kendi cümlenizle arayın" kutusu.
#
# ⚠️ VARSAYILAN KAPALI. Anahtar boşsa kutu hiç basılmaz; normal filtreler
# her hâlükârda çalışır. Çalışmayan bir arama kutusu göstermiyoruz.
#
# ⚠️ KVKK — YURT DIŞINA VERİ AKTARIMI
# Ziyaretçinin yazdığı metin Anthropic'in sunucularına gider. Yalnızca metin
# gönderilir (IP, oturum, kimlik yok) ve kutunun altında bu açıkça yazar.
# Aydınlatma metnine bu aktarımın EKLENMESİ gerekir — avukat işi.
# Metin hazır olmadan bu anahtarı ÜRETİMDE tanımlamayın.
#
# ⚠️ SUNUCU TARAFI — asla istemciye gönderilmez, NEXT_PUBLIC_ ön eki ALMAZ.
# Nereden: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Kullanılacak model. Boşsa claude-opus-5.
# Bu iş (kısa metinden yapılandırılmış filtre) daha küçük bir modelle de
# yapılabilir ve arama başına maliyet doğrudan buna bağlıdır. Model seçimi
# bir maliyet kararıdır; bkz. docs/SENDEN-BEKLENENLER.md.
ANTHROPIC_ARAMA_MODELI=


# --- Üretime özel değişkenler ----------------------------------------------
#
# Aşağıdakiler burada YOK, çünkü yalnızca üretimde anlamlılar. Tamamı
# gerekçesiyle birlikte `.env.production.example` içinde:
#
#   SITE_ADRESI          çalışma zamanı adres (NEXT_PUBLIC_* derlemeye gömülür)
#   RESTIC_REPOSITORY    yedek deposu
#   RESTIC_PASSWORD      ⚠️ kaybedilirse yedekler geri alınamaz
#   UYGULAMA_IMAJI       geri dönüş için imaj etiketi
