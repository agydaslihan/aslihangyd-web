# =============================================================================
# aslihangyd.com — ÜRETİM ortam değişkenleri örneği
#
# Sunucuda:
#   cp .env.production.example .env
#
# ⚠️ `.env.example` GELİŞTİRME içindir. Bu dosya ondan türetilmez —
# üretimde farklı olan her değerin yanında sebebi yazılı.
#
# CLAUDE.md kural 7: hiçbir sır koda girmez. Bu dosya yalnızca yer
# tutucular içerir; gerçek değerler yalnızca sunucudaki `.env` dosyasında
# yaşar ve o dosya asla commit edilmez.
#
# ── OKUMA KILAVUZU ──────────────────────────────────────────────────────────
#   ⚠️ FARKLI   → geliştirmedeki değerden başka olmak ZORUNDA
#   ✅ AYNI     → geliştirmeyle aynı kalabilir
#   🆕 YALNIZCA ÜRETİM → geliştirmede hiç kullanılmaz
#
# ⚠️ BURADAKİ DEĞERLER ÇALIŞMA ZAMANINDA OKUNUR — imajı yeniden derlemek
# gerekmez. Değiştirdikten sonra `docker compose ... up -d` yeter.
#
# Tek istisna `NEXT_PUBLIC_SERVER_URL`: o önek derleme anına gömülür ve
# yalnızca yedek olarak duruyor. Asıl kaynak ön eksiz `SITE_ADRESI`.
# 12 Ağustos 2026'ya kadar dokuz değişken bu tuzağa düşmüştü — harita,
# bot koruması, analitik ve videolar yayında sessizce ölüydü.
# Gerekçe: src/lib/harita/sunucu.ts
# =============================================================================


# ── Veritabanı ──────────────────────────────────────────────────────────────

# ✅ AYNI — ad ve kullanıcı değişmek zorunda değil.
POSTGRES_USER=aslihangyd
POSTGRES_DB=aslihangyd

# ⚠️ FARKLI — üretim şifresi geliştirme şifresiyle aynı OLMAMALI.
# Üret:  openssl rand -hex 24
POSTGRES_PASSWORD=AslihanTarafindanDoldurulacak

# ⚠️ FARKLI — sunucu adı `localhost` değil `postgres`.
#
# Üretimde uygulama bir kapta çalışıyor ve veritabanına Docker ağı
# üzerinden, SERVİS ADIYLA ulaşıyor. `localhost` yazılırsa uygulama kendi
# kabına bağlanmaya çalışır ve `ECONNREFUSED` alır.
#
# Şifre yukarıdaki POSTGRES_PASSWORD ile aynı olmalı.
DATABASE_URI=postgres://aslihangyd:AslihanTarafindanDoldurulacak@postgres:5432/aslihangyd

# ⚠️ FARKLI — aynı sebep: `localhost` değil `redis`.
REDIS_URL=redis://redis:6379


# ── Payload CMS ─────────────────────────────────────────────────────────────

# ⚠️ FARKLI — geliştirme sırrıyla AYNI OLAMAZ.
#
# Bu anahtar oturum çerezlerini imzalıyor. Geliştirme değerini üretimde
# kullanmak, geliştirme makinesinde üretilmiş bir çerezin üretimde geçerli
# olması demektir.
# Üret:  openssl rand -base64 48
PAYLOAD_SECRET=AslihanTarafindanDoldurulacak

# ✅ AYNI biçim, farklı alan adı.
#
# ⚠️ PORT YOK. Bu makineye özel bir dış IP tahsis edildi ve 80/443 boş;
# Caddy TLS'i Let's Encrypt ile kendisi alıyor. Belge bir süre `:8443`
# yazıyordu — o kurgu portlar doluyken zorunluluktu, artık değil ve
# `docker/compose.prod.yml` 80/443 yayınlıyor. Porta takılı bir adres
# arama motoruna ULAŞILAMAYAN kanonik adresler bildirir.
#
# ⚠️ Bu satır yalnızca DERLEME ZAMANI yedeğidir; asıl kaynak aşağıdaki
# ön eksiz SITE_ADRESI.
NEXT_PUBLIC_SERVER_URL=https://aslihangyd.com

# 🆕 YALNIZCA ÜRETİM — ve atlanması sessiz bir hataya yol açar.
#
# ⚠️ `NEXT_PUBLIC_*` değişkenleri DERLEME ANINDA koda gömülür; sunucu
# tarafında bile çalışma zamanında okunmazlar. İmaj CI'da derlendiği için
# oradaki NEXT_PUBLIC_SERVER_URL değeri imajın içine yazılır ve sunucudaki
# `.env` onu DEĞİŞTİREMEZ — site haritası yanlış adresi yayınlar.
#
# Ön eksiz bu ad çalışma zamanında okunur ve öncelik onundur.
# Gerekçenin tamamı: src/lib/site.ts
#
# Değeri NEXT_PUBLIC_SERVER_URL ile birebir aynı yazın.
SITE_ADRESI=https://aslihangyd.com


# ── Bakım görevleri ─────────────────────────────────────────────────────────

# 🆕 YALNIZCA ÜRETİM — cron görevlerinin `/api/bakim` ucuna kimlik kanıtı.
#
# ⚠️ Boş bırakılırsa bakım ucu ÇALIŞMAZ. EİDS yetki süresi kontrolü bu uca
# bağlı ve yasal yükümlülük: yetkisi dolan ilan yayında kalırsa idari
# yaptırım riski doğar.
#
# Kurulmadığında panel ana ekranında kalıcı uyarı görünür.
# Üret:  openssl rand -hex 32
BAKIM_ANAHTARI=AslihanTarafindanDoldurulacak


# ── Yedekleme ───────────────────────────────────────────────────────────────
# 🆕 YALNIZCA ÜRETİM. scripts/yedekle.sh ve scripts/geri-yukle.sh okur;
# tanımsızsa betikler ilk satırda durur.

# restic deposunun adresi.
# Örnek biçimler:
#   s3:s3.eu-central-1.amazonaws.com/aslihangyd-yedek
#   b2:aslihangyd-yedek:/
#   sftp:deploy@yedek-sunucu:/yedek/aslihangyd
RESTIC_REPOSITORY=AslihanTarafindanDoldurulacak

# ⚠️ BU PAROLAYI KAYBEDERSENİZ YEDEKLER GERİ ALINAMAZ.
# restic deposu bu parolayla şifreli; sıfırlama yolu yoktur.
# Parolayı `.env` dışında ayrı bir yerde de saklayın — sunucu tamamen
# giderse `.env` de onunla gider.
# Üret:  openssl rand -base64 32
RESTIC_PASSWORD=AslihanTarafindanDoldurulacak

# Depo sağlayıcısı S3 uyumluysa gerekir; sftp/yerel depoda gerekmez.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# ── İmaj ────────────────────────────────────────────────────────────────────

# 🆕 YALNIZCA ÜRETİM. Boş bırakılırsa `:latest` kullanılır.
#
# Geri dönüş için burayı bir commit SHA'sına sabitleyin — `latest` hangi
# kodun çalıştığını söylemez. Etiketler `.github/workflows/imaj.yml`
# tarafından üretiliyor.
# Örnek: ghcr.io/agydaslihan/aslihangyd-web:1e5d79f...
# UYGULAMA_IMAJI=ghcr.io/agydaslihan/aslihangyd-web:latest


# ── Harita ──────────────────────────────────────────────────────────────────

# ✅ AYNI anahtar kullanılabilir.
#
# ⚠️ ALAN ADI KISITI KOYUN. Anahtar harita isteklerinin içinde tarayıcıya
# gider; gizlenemez. Tek gerçek koruma MapTiler panelinden kısıtlamaktır:
# Account → API Keys → anahtar → Allowed origins → aslihangyd.com
#
# ⚠️ Boşsa /harita üretimde boş durumda kalır — OSM'den içe aktarılan ilgi
# noktalarının göründüğü tek yer orasıdır.
MAPTILER_ANAHTARI=AslihanTarafindanDoldurulacak


# ── Bot koruması (Turnstile) ────────────────────────────────────────────────
# Cloudflare Turnstile. Nereden: dash.cloudflare.com → Turnstile → Add site
#
# ⚠️ Turnstile yalnızca ana makine adına bakar: `aslihangyd.com`.
#
# İkisi de boşsa doğrulama katmanı devre dışı kalır — form çalışır ama
# yalnızca bal küpü ve hız sınırı korur. Üretimde ikisini de doldurun.

# Site anahtarı: widget'ta görünür, gizli değildir.
TURNSTILE_SITE_ANAHTARI=AslihanTarafindanDoldurulacak

# ⚠️ SUNUCU TARAFI — asla istemciye gönderilmez.
TURNSTILE_GIZLI_ANAHTAR=AslihanTarafindanDoldurulacak


# ── İletişim ────────────────────────────────────────────────────────────────
# ✅ AYNI

# Uluslararası biçim, + ve boşluk olmadan. Örnek biçim: 905XXXXXXXXX
#
# ⚠️ Üçü de YEDEKTİR — asıl kaynak CMS → Kurumsal Bilgiler. Panelden
# girilen değer buradakini ezer.
WHATSAPP_NUMARA=AslihanTarafindanDoldurulacak
ILETISIM_TELEFON=AslihanTarafindanDoldurulacak
ILETISIM_EPOSTA=AslihanTarafindanDoldurulacak


# ── Video / CDN ─────────────────────────────────────────────────────────────
# ✅ AYNI — geliştirmeyle aynı kütüphane kullanılabilir.
# CLAUDE.md kod standardı: video ASLA self-host edilmez.
#
# ⚠️ İkisi de boşsa video bölümü "oynatıcı yapılandırılmadı" der.
#
# ⚠️ Kütüphane kimliğinin ayrı bir "istemci kopyası" ARTIK YOK; oynatıcı
# adresi sunucuda kuruluyor ve tek değişken yetiyor.
BUNNY_STREAM_LIBRARY_ID=AslihanTarafindanDoldurulacak
BUNNY_STREAM_CDN_HOSTNAME=AslihanTarafindanDoldurulacak

# ⚠️ SUNUCU TARAFI — yükleme yetkisi taşır, ziyaretçiye asla gitmez.
BUNNY_STREAM_API_KEY=AslihanTarafindanDoldurulacak


# ── OpenStreetMap içe aktarma ───────────────────────────────────────────────

# ✅ AYNI — ve BOŞ BIRAKILABİLİR.
#
# Boşsa kod herkese açık `overpass-api.de` sunucusuna düşer. Değişken
# yalnızca ayna sunucu kullanmak içindir: genel sunucu yoğun saatlerde
# yavaşlıyor ve büyük bir içe aktarma zaman aşımına uğrayabiliyor.
OVERPASS_ADRESI=


# ── Google Places (isteğe bağlı zenginleştirme) ─────────────────────────────
# 🆕 Üretimde de VARSAYILAN KAPALI. OSM'nin zayıf kaldığı yerde işletme adı,
# çalışma saati ve kategori doğruluğu için resmi Places API (New).
#
# ⚠️ SCRAPING DEĞİL: kendi anahtarımızla, lisanslı, resmi uç noktadan.
#
# ⚠️ İKİ KOŞUL BİRDEN gerekir — anahtarı sunucuya koymak katmanı AÇMAZ:
#   1) bu değişken dolu olacak
#   2) Panel → Site Bölümleri → "Google Places" açık olacak
# Biri eksikse hiçbir Google çağrısı yapılmaz; site OSM verisiyle çalışır.
# Servis ücretli olduğu için açma kararı bilinçli olarak insana bırakıldı.
#
# ⚠️ LİSANS — ÖNBELLEKLEME YASAK. Google'dan gelen ad, adres ve çalışma
# saati hiçbir yere YAZILMAZ. Veritabanında saklanan tek şey yer kimliği
# (googlePlaceId); geri kalanı ziyaretçi sorduğu anda çekilir ve
# gösterildiği yerde Google atfı görünür.
#
# ⚠️ MALİYET — her arama ve her detay çağrısı faturalanır. Aylık sayaç:
# Panel → Google Places. Ziyaretçiye açık detay çağrısında dakikada 20
# istek sınırı var. Fatura uyarısını Google Cloud tarafında da kurun.
#
# ⚠️ SUNUCU TARAFI — asla istemciye gönderilmez, NEXT_PUBLIC_ ön eki ALMAZ.
# Nereden: console.cloud.google.com → "Places API (New)" etkinleştir →
#          Kimlik bilgileri → API anahtarı. Anahtara kısıt koyun
#          (sunucu IP kısıtı + yalnızca Places API).
GOOGLE_PLACES_API_KEY=


# ── Analitik ────────────────────────────────────────────────────────────────
# CLAUDE.md kural 8: çerez onayı alınmadan analitik scripti YÜKLENMEZ.
# Bu değişkenlerin dolu olması scriptin yükleneceği anlamına gelmez.
#
# 🆕 Genellikle yalnızca üretimde doldurulur: geliştirme trafiğini
# ölçüme karıştırmak veriyi bozar.
UMAMI_URL=
UMAMI_SITE_ID=


# ── Geliştirmede olup üretimde OLMAYANLAR ───────────────────────────────────
#
# DEV_IZINLI_KAYNAKLAR — yalnızca `pnpm dev` için. Üretim derlemesinde
#   okunmaz; buraya yazmak bir işe yaramaz.
#
# TEMIZLE — yalnızca tohum betiği (`pnpm seed`) için. Tohumlama üretimde
#   zaten çalışmaz: `scripts/seed.ts` NODE_ENV 'development' değilse durur.
#
# NODE_ENV — compose dosyası `production` olarak veriyor, elle yazmayın.
# MEDYA_DIZINI — compose dosyası `/uygulama/medya` olarak veriyor.
